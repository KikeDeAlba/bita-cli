{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bita hook session-start", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "bita hook session-end", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bita hook touched", "timeout": 10, "async": true }]
      }
    ]
  }
}
