{
  "name": "@kikedealba/bita",
  "version": "0.10.0",
  "description": "Registro de tiempo local que documenta el trabajo y lo vuelca a Jira, con integraciones para agentes de código.",
  "license": "MIT",
  "author": "Jesus Enrique De Alba Gaytan",
  "homepage": "https://github.com/KikeDeAlba/bita-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KikeDeAlba/bita-cli.git"
  },
  "bugs": {
    "url": "https://github.com/KikeDeAlba/bita-cli/issues"
  },
  "keywords": [
    "time-tracking",
    "jira",
    "worklog",
    "documentation",
    "claude-code",
    "opencode",
    "codex",
    "cli",
    "sqlite"
  ],
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bita": "./dist/bin/bita.js"
  },
  "files": [
    "dist",
    "skill",
    "skill-opencode",
    "skill-codex",
    "commands",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "bita": "node src/bin/bita.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
